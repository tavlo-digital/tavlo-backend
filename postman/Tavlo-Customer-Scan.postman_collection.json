{
  "info": {
    "name": "Tavlo — Customer Scan",
    "_postman_id": "tavlo-customer-scan",
    "description": "Customer QR scan endpoint. Requires customer Sanctum bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string",
      "description": "Plain-text Sanctum token for the authenticated customer."
    },
    {
      "key": "qrToken",
      "value": "d5938525-f2a5-4849-803e-d579582af11f",
      "type": "string"
    },
    {
      "key": "tablePin",
      "value": "0473",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customer Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/customer/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "login"]
        },
        "description": "Optional helper. Copy the returned token into the `customerToken` collection variable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('customerToken', json.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Scan Table QR",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "text/plain" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{qrToken}}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/scan",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "scan"]
        },
        "description": "Customer scans a printed table QR. If the table is not active yet, this creates the owner session and returns a 4-digit PIN. If the table is already active, the response returns status=active and requiresPin=true so the UI can ask the customer for the shared PIN."
      },
      "response": [
        {
          "name": "201 Created",
          "originalRequest": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "text/plain" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "d5938525-f2a5-4849-803e-d579582af11f"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/table/scan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "table", "scan"]
            }
          },
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"pin\": \"0473\",\n  \"session\": {\n    \"id\": \"12\",\n    \"status\": \"active\",\n    \"scannedAt\": \"2026-04-23T10:15:00+00:00\"\n  },\n  \"table\": { \"id\": \"5\", \"number\": 3, \"name\": \"T3\" },\n  \"vendor\": { \"id\": \"vnd_abc123\", \"name\": \"La Bella Vista\" }\n}"
        },
        {
          "name": "409 Active Table",
          "status": "Conflict",
          "code": 409,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"This table already has an active session\",\n  \"status\": \"active\",\n  \"requiresPin\": true,\n  \"table\": { \"id\": \"5\", \"number\": 3, \"name\": \"T3\" },\n  \"vendor\": { \"id\": \"VID-8492\", \"name\": \"Bella Italia\" }\n}"
        },
        {
          "name": "410 Invalid QR",
          "status": "Gone",
          "code": 410,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"This QR code is no longer valid\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
        }
      ]
    },
    {
      "name": "Join Active Table With PIN",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{qrToken}}\",\n  \"pin\": \"{{tablePin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/pin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "pin"]
        },
        "description": "Join an already-active table by entering the owner PIN. This creates a table_scan_sessions row for the joining customer without assigning a new PIN to them."
      },
      "response": [
        {
          "name": "201 Joined",
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"pin\": null,\n  \"session\": {\n    \"id\": \"13\",\n    \"status\": \"active\",\n    \"scannedAt\": \"2026-04-23T10:17:00+00:00\"\n  },\n  \"table\": { \"id\": \"5\", \"number\": 3, \"name\": \"T3\" },\n  \"vendor\": { \"id\": \"VID-8492\", \"name\": \"Bella Italia\" }\n}"
        },
        {
          "name": "200 Already Joined",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"pin\": null,\n  \"session\": {\n    \"id\": \"13\",\n    \"status\": \"active\",\n    \"scannedAt\": \"2026-04-23T10:17:00+00:00\"\n  },\n  \"table\": { \"id\": \"5\", \"number\": 3, \"name\": \"T3\" },\n  \"vendor\": { \"id\": \"VID-8492\", \"name\": \"Bella Italia\" }\n}"
        },
        {
          "name": "422 Invalid PIN",
          "status": "Unprocessable Entity",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"The provided PIN is invalid for this table\"\n}"
        }
      ]
    },
    {
      "name": "Order Start",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/order/start",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "order", "start"]
        },
        "description": "Returns a payment summary for the customer's current table: each active session (person) with their items, totals, and an is_mine flag, plus a table-wide grand total."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"table\": { \"id\": 5, \"number\": 3, \"name\": \"T3\" },\n  \"people\": [\n    {\n      \"session_id\": 12,\n      \"customer_id\": 7,\n      \"is_me\": true,\n      \"name\": \"Alex Doe\",\n      \"item_count\": 3,\n      \"total_price\": 12.50,\n      \"items\": [\n        {\n          \"cart_item_id\": 1,\n          \"menu_item_id\": 42,\n          \"name\": \"Fries\",\n          \"image_url\": null,\n          \"quantity\": 2,\n          \"unit_price\": 3.50,\n          \"total_price\": 7.00,\n          \"is_mine\": true\n        },\n        {\n          \"cart_item_id\": 2,\n          \"menu_item_id\": 51,\n          \"name\": \"Coke\",\n          \"image_url\": null,\n          \"quantity\": 1,\n          \"unit_price\": 5.50,\n          \"total_price\": 5.50,\n          \"is_mine\": true\n        }\n      ]\n    },\n    {\n      \"session_id\": 13,\n      \"customer_id\": 9,\n      \"is_me\": false,\n      \"name\": \"Sam Lee\",\n      \"item_count\": 1,\n      \"total_price\": 18.99,\n      \"items\": [\n        {\n          \"cart_item_id\": 3,\n          \"menu_item_id\": 42,\n          \"name\": \"4 Piece Chicken Box\",\n          \"image_url\": \"http://localhost:8000/media/menu-items/42/photo/abc123.jpg\",\n          \"quantity\": 1,\n          \"unit_price\": 18.99,\n          \"total_price\": 18.99,\n          \"is_mine\": false\n        }\n      ]\n    }\n  ],\n  \"summary\": {\n    \"item_count\": 4,\n    \"total_price\": 31.49\n  }\n}"
        },
        {
          "name": "422 No Active Session",
          "status": "Unprocessable Entity",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"No active table session found.\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
        }
      ]
    },
    {
      "name": "Create Order Draft",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/order/draft",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "order", "draft"]
        },
        "description": "Creates a draft order from the customer's own cart items. No request body required. Snapshots the customer's items at full price (no splitting). The order is linked to the authenticated customer via customer_id."
      },
      "response": [
        {
          "name": "201 Created",
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"order\": {\n    \"id\": 101,\n    \"order_public_id\": \"ord-aB3xK9pQrS12\",\n    \"customer_id\": 7,\n    \"status\": \"draft\",\n    \"payment_pending\": true,\n    \"amount\": 12.50,\n    \"currency\": \"EUR\",\n    \"items_count\": 3,\n    \"table_scan_session_id\": 12,\n    \"vendor_id\": 1,\n    \"created_at\": \"2026-05-01T10:30:00+00:00\"\n  }\n}"
        },
        {
          "name": "422 No Active Session",
          "status": "Unprocessable Entity",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"No active table session found.\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
        }
      ]
    },
    {
      "name": "Update Order",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 101,\n  \"items_count\": 3,\n  \"items\": [\n    {\n      \"cart_item_id\": 1,\n      \"menu_item_id\": 42,\n      \"name\": \"Fries\",\n      \"quantity\": 2,\n      \"unit_price\": 3.50,\n      \"line_total\": 7.00,\n      \"is_mine\": true\n    }\n  ],\n  \"shared_items\": [\n    {\n      \"cart_item_id\": 3,\n      \"shared_between\": 2,\n      \"shared_between_ids\": [7, 9],\n      \"line_total\": 18.99,\n      \"is_mine\": false\n    }\n  ]\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/order/update",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "order", "update"]
        },
        "description": "Update an existing draft order owned by the authenticated customer. Matched by id + customer_id. Accepts items_count, items, and shared_items. shared_items are validated: cart_item_ids must belong to the same table, shared_between_ids customers must also be at the table."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"order\": {\n    \"id\": 101,\n    \"order_public_id\": \"ord-aB3xK9pQrS12\",\n    \"customer_id\": 7,\n    \"status\": \"draft\",\n    \"payment_pending\": true,\n    \"amount\": 12.50,\n    \"currency\": \"EUR\",\n    \"items_count\": 3,\n    \"items\": [\n      {\n        \"cart_item_id\": 1,\n        \"menu_item_id\": 42,\n        \"name\": \"Fries\",\n        \"quantity\": 2,\n        \"unit_price\": 3.50,\n        \"line_total\": 7.00,\n        \"is_mine\": true\n      }\n    ],\n    \"shared_items\": [\n      {\n        \"cart_item_id\": 3,\n        \"shared_between\": 2,\n        \"shared_between_ids\": [7, 9],\n        \"line_total\": 18.99,\n        \"is_mine\": false\n      }\n    ],\n    \"table_scan_session_id\": 12,\n    \"vendor_id\": 1,\n    \"updated_at\": \"2026-05-01T10:32:00+00:00\"\n  }\n}"
        },
        {
          "name": "404 Order Not Found",
          "status": "Not Found",
          "code": 404,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Order not found.\"\n}"
        },
        {
          "name": "422 Invalid Shared Item",
          "status": "Unprocessable Entity",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"One or more shared cart items do not belong to this table.\",\n  \"invalid_cart_item_ids\": [99]\n}"
        },
        {
          "name": "422 Invalid Shared Customer",
          "status": "Unprocessable Entity",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"One or more shared_between_ids customers are not at this table.\",\n  \"invalid_customer_ids\": [55]\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
        }
      ]
    },
    {
      "name": "Create Order Confirmed",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/order/confirmed",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "order", "confirmed"]
        },
        "description": "Confirms the customer's latest draft order. No request body required. Calculates the final amount from the order's saved items and shared_items using the bill-splitting formula: sum all item line_totals, then for each shared_item (shared_between = N): share = line_total / N. If is_mine=true, subtract (N-1) × share; if is_mine=false, add share."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"order\": {\n    \"id\": 101,\n    \"order_public_id\": \"ord-aB3xK9pQrS12\",\n    \"customer_id\": 7,\n    \"status\": \"confirmed\",\n    \"payment_pending\": true,\n    \"amount\": 22.00,\n    \"currency\": \"EUR\",\n    \"items_count\": 3,\n    \"table_scan_session_id\": 12,\n    \"vendor_id\": 1,\n    \"created_at\": \"2026-05-01T10:30:00+00:00\"\n  }\n}"
        },
        {
          "name": "404 No Draft Order",
          "status": "Not Found",
          "code": 404,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"No draft order found.\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
        }
      ]
    }
  ]
}
