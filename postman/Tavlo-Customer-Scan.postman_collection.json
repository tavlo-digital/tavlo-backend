{
  "info": {
    "name": "Tavlo — Customer Scan",
    "_postman_id": "tavlo-customer-scan",
    "description": "Customer QR scan endpoint. Requires customer Sanctum bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string",
      "description": "Plain-text Sanctum token for the authenticated customer."
    },
    {
      "key": "qrToken",
      "value": "d5938525-f2a5-4849-803e-d579582af11f",
      "type": "string"
    },
    {
      "key": "tablePin",
      "value": "0473",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customer Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/customer/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "login"]
        },
        "description": "Optional helper. Copy the returned token into the `customerToken` collection variable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('customerToken', json.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Scan Table QR",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "text/plain" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{qrToken}}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/scan",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "scan"]
        },
        "description": "Customer scans a printed table QR. If the table is not active yet, this creates the owner session and returns a 4-digit PIN. If the table is already active, the response returns status=active and requiresPin=true so the UI can ask the customer for the shared PIN."
      },
      "response": [
        {
          "name": "201 Created",
          "originalRequest": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "text/plain" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "d5938525-f2a5-4849-803e-d579582af11f"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/table/scan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "table", "scan"]
            }
          },
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"pin\": \"0473\",\n  \"session\": {\n    \"id\": \"12\",\n    \"status\": \"active\",\n    \"scannedAt\": \"2026-04-23T10:15:00+00:00\"\n  },\n  \"table\": { \"id\": \"5\", \"number\": 3, \"name\": \"T3\" },\n  \"vendor\": { \"id\": \"vnd_abc123\", \"name\": \"La Bella Vista\" }\n}"
        },
        {
          "name": "409 Active Table",
          "status": "Conflict",
          "code": 409,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"This table already has an active session\",\n  \"status\": \"active\",\n  \"requiresPin\": true,\n  \"table\": { \"id\": \"5\", \"number\": 3, \"name\": \"T3\" },\n  \"vendor\": { \"id\": \"VID-8492\", \"name\": \"Bella Italia\" }\n}"
        },
        {
          "name": "410 Invalid QR",
          "status": "Gone",
          "code": 410,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"This QR code is no longer valid\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
        }
      ]
    },
    {
      "name": "Join Active Table With PIN",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{qrToken}}\",\n  \"pin\": \"{{tablePin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/pin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "pin"]
        },
        "description": "Join an already-active table by entering the owner PIN. This creates a table_scan_sessions row for the joining customer without assigning a new PIN to them."
      },
      "response": [
        {
          "name": "201 Joined",
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"pin\": null,\n  \"session\": {\n    \"id\": \"13\",\n    \"status\": \"active\",\n    \"scannedAt\": \"2026-04-23T10:17:00+00:00\"\n  },\n  \"table\": { \"id\": \"5\", \"number\": 3, \"name\": \"T3\" },\n  \"vendor\": { \"id\": \"VID-8492\", \"name\": \"Bella Italia\" }\n}"
        },
        {
          "name": "200 Already Joined",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"pin\": null,\n  \"session\": {\n    \"id\": \"13\",\n    \"status\": \"active\",\n    \"scannedAt\": \"2026-04-23T10:17:00+00:00\"\n  },\n  \"table\": { \"id\": \"5\", \"number\": 3, \"name\": \"T3\" },\n  \"vendor\": { \"id\": \"VID-8492\", \"name\": \"Bella Italia\" }\n}"
        },
        {
          "name": "422 Invalid PIN",
          "status": "Unprocessable Entity",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"The provided PIN is invalid for this table\"\n}"
        }
      ]
    },
    {
      "name": "Get Table Payment Summary",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/order",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "order"]
        },
        "description": "Returns a payment-ready snapshot of the authenticated customer's current table. Includes one node per active session at the same table (with name, items and total) plus a table-wide grand total. The current table is derived from the customer's active table_scan_sessions row — no table_id needs to be passed."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"table\": { \"id\": 5, \"number\": 3, \"name\": \"T3\" },\n  \"people\": [\n    {\n      \"session_id\": 12,\n      \"customer_id\": 7,\n      \"is_me\": true,\n      \"name\": \"Alex Doe\",\n      \"item_count\": 3,\n      \"total_price\": 12.50,\n      \"items\": [\n        {\n          \"cart_item_id\": 1,\n          \"menu_item_id\": 42,\n          \"name\": \"Fries\",\n          \"image_url\": null,\n          \"quantity\": 2,\n          \"unit_price\": 3.50,\n          \"total_price\": 7.00,\n          \"is_mine\": true\n        },\n        {\n          \"cart_item_id\": 2,\n          \"menu_item_id\": 51,\n          \"name\": \"Coke\",\n          \"image_url\": null,\n          \"quantity\": 1,\n          \"unit_price\": 5.50,\n          \"total_price\": 5.50,\n          \"is_mine\": true\n        }\n      ]\n    },\n    {\n      \"session_id\": 13,\n      \"customer_id\": 9,\n      \"is_me\": false,\n      \"name\": \"Sam Lee\",\n      \"item_count\": 1,\n      \"total_price\": 18.99,\n      \"items\": [\n        {\n          \"cart_item_id\": 3,\n          \"menu_item_id\": 42,\n          \"name\": \"4 Piece chicken Box\",\n          \"image_url\": \"http://localhost:8000/media/menu-items/42/photo/abc123.jpg\",\n          \"quantity\": 1,\n          \"unit_price\": 18.99,\n          \"total_price\": 18.99,\n          \"is_mine\": false\n        }\n      ]\n    }\n  ],\n  \"summary\": {\n    \"item_count\": 4,\n    \"total_price\": 31.49\n  }\n}"
        },
        {
          "name": "404 No Active Table",
          "status": "Not Found",
          "code": 404,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"No active table session found.\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
        }
      ]
    },
    {
      "name": "Pay Now (Create Pending Order)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shared_items\": [\n    { \"cart_item_id\": 3, \"shared_between\": 3 },\n    { \"cart_item_id\": 7, \"shared_between\": 2 }\n  ]\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/customer/table/order",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "table", "order"]
        },
        "description": "Creates a pending order for the authenticated customer based on the current table cart, optionally splitting selected items across N people.\n\n- shared_items[].cart_item_id must belong to a session at the same table.\n- shared_items[].shared_between must be >= 2.\n- For each shared item: share = line_total / shared_between. If the item is the customer's own, they pay only `share` (instead of full); if it belongs to another person, `share` is added to the customer's bill.\n- Items not listed in shared_items are billed normally (full price for the customer's own items, ignored for others').\n- The created Order has payment_pending=true and status=pending."
      },
      "response": [
        {
          "name": "201 Created",
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"order\": {\n    \"id\": 101,\n    \"order_public_id\": \"ord-aB3xK9pQrS12\",\n    \"status\": \"pending\",\n    \"payment_pending\": true,\n    \"amount\": 16.49,\n    \"currency\": \"EUR\",\n    \"items_count\": 3,\n    \"table_scan_session_id\": 12,\n    \"vendor_id\": 1,\n    \"created_at\": \"2026-04-27T10:30:00+00:00\"\n  }\n}"
        },
        {
          "name": "422 Invalid Shared Item",
          "status": "Unprocessable Entity",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"One or more shared cart items do not belong to this table.\",\n  \"invalid_cart_item_ids\": [99]\n}"
        },
        {
          "name": "422 No Active Session",
          "status": "Unprocessable Entity",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"No active table session found.\"\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
        }
      ]
    }
  ]
}
